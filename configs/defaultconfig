
#
# CPU
#
CONFIG_PER_CPU_BOOT_STACK_SIZE_SHIFT=16
CONFIG_MAX_CPU_COUNT=8
CONFIG_PER_TASK_STACK_SIZE_SHIFT=16
# end of CPU

#
# Scheduler
#
CONFIG_SCHEDULER_POLICY_ROUND_ROBIN=y
CONFIG_TIMER_RESCHED_MS=100
# end of Scheduler

#
# Building
#
CONFIG_WARNING_AS_ERROR=y
# CONFIG_OPTIMIZATIONS_NONE is not set
# CONFIG_OPTIMIZATIONS_LOW is not set
# CONFIG_OPTIMIZATIONS_MEDIUM is not set
CONFIG_OPTIMIZATIONS_HIGH=y
# CONFIG_OPTIMIZATIONS_MAX is not set
# end of Building

#
# Drivers
#
CONFIG_MAX_ACTIVE_DEVICES_COUNT=256
# end of Drivers

#
# Running via qemu
#
CONFIG_QEMU_CPU_COUNT=4
CONFIG_QEMU_PHYSICAL_MEMORY_MB=128
CONFIG_QEMU_WITH_DISPLAY=y
# end of QEMU

#
# Hacking
#
CONFIG_DEBUG_CHECKS=y
CONFIG_DEBUG_SYMBOLS=y
# CONFIG_ENABLE_SEMIHOSTING is not set
# CONFIG_LOGGING_LEVEL_TRACE is not set
# CONFIG_LOGGING_LEVEL_DEBUG is not set
# CONFIG_LOGGING_LEVEL_INFO is not set
# CONFIG_LOGGING_LEVEL_WARN is not set
CONFIG_LOGGING_LEVEL_ERROR=y
# end of Hacking
