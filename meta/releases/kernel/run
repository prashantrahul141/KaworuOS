ISO_PATH=KaworuOS.iso
EFI_FIRMWARE=. # Point to efi firmware for qemu

qemu-system-aarch64 -M virt,acpi=off -cpu cortex-a72 \
			-m 128M \
			-device ramfb \
			-device qemu-xhci \
			-device usb-kbd \
			-device usb-tablet \
			-serial stdio \
			-drive if=pflash,unit=0,format=raw,file="$EFI_FIRMWARE",readonly=on \
			-cdrom "$ISO_PATH" \
			-smp 4
