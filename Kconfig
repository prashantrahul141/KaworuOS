# building
menu "General Setup"
config PER_CPU_STACK_SIZE_SHIFT
    int "Per Cpu Stack size in shift"
    default 16
    help
        - This stack is embedded in the elf itself. "shift" means it will be used to left shift 1 to get a aligned value.
        Example: shift value = 16
                1 << 16 = 65536 bytes per cpu


config TIMER_RESCHED_MS
        int "Timer fires after every given miliseconds"
        default 100
endmenu

menu "Building"
choice OPTIMIZATIONS
    prompt "Optimizations level"
    default OPTIMIZATIONS_NONE

    config OPTIMIZATIONS_NONE
        bool "None"

    config OPTIMIZATIONS_LOW
        bool "Low"

    config OPTIMIZATIONS_MEDIUM
        bool "Medium"

    config OPTIMIZATIONS_HIGH
        bool "High (recommended)"

    config OPTIMIZATIONS_MAX
        bool "Max"
endchoice
endmenu

# drivers
menu "Drivers"
    config MAX_ACTIVE_DEVICES_COUNT
        int "Max number of devices that can be active"
        default 256
endmenu

# running
menu "Running via qemu"
config CPU_COUNT
    int "Cpu count"
    default 4

config PHYSICAL_MEMORY_MB
    int "Physical memory (in MB)"
    default 512
endmenu

# hacking
menu "Hacking"
config DEBUG_CHECKS
    bool "Enable Debug checks"
    default y

config DEBUG_SYMBOLS
    bool "Enable debug symbols"
    default y

config ENABLE_SEMIHOSTING
    bool "Enable semihosting support"
    default n

choice LOGGING_LEVEL
    prompt "Set level of logging"
    default LOGGING_LEVEL_DEBUG

    config LOGGING_LEVEL_TRACE
        bool "Trace"

    config LOGGING_LEVEL_DEBUG
        bool "Debug"

    config LOGGING_LEVEL_INFO
        bool "Info"

    config LOGGING_LEVEL_WARN
        bool "Warn"

    config LOGGING_LEVEL_ERROR
        bool "Error"
endchoice
endmenu
